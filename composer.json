{
    "name": "captnemo/playdate-docset",
    "description": "A Dash docset for the official Playdate SDK documentation.",
    "type": "project",
    "require": {
        "godbout/dash-docset-builder": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Docsets\\": "app/Docsets/"
        }
    },
    "scripts": {
        "build": "@php -d extension=pdo_sqlite vendor/bin/dash-docset build Playdate"
    },
    "config": {
        "platform-check": false
    }
}
